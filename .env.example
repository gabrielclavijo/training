# Copia este archivo como .env.local y llena los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API). Ambos valores son públicos.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Solo para desarrollo local: entra sin Supabase con una sesión ficticia.
# VITE_FAKE_AUTH=1
